{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" --scope role"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^pl:team-pl-",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/memo_capture.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/memo_capture.py\""
          }
        ]
      }
    ]
  }
}
